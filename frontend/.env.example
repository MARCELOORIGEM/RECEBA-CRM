# Copie para .env. Variáveis de CRA são embutidas no bundle em build time —
# nunca coloque segredo aqui: tudo isso fica visível no navegador.

REACT_APP_BACKEND_URL=http://localhost:8001

# Porta do socket do dev server (preview em HTTPS usa 443).
WDS_SOCKET_PORT=3000

ENABLE_HEALTH_CHECK=false

# Botões de preenchimento rápido na tela de login. As credenciais ficavam
# escritas no código e apareciam em qualquer ambiente, inclusive no preview
# público. Mantenha "false" fora do seu ambiente local.
REACT_APP_SHOW_DEMO_LOGIN=false
REACT_APP_DEMO_ADMIN_EMAIL=
REACT_APP_DEMO_ADMIN_PASSWORD=
REACT_APP_DEMO_MANAGER_EMAIL=
REACT_APP_DEMO_MANAGER_PASSWORD=
