# Miliano CRM — configuração do docker compose.
#
# Gere este arquivo pronto, com segredos aleatórios:
#     python scripts/gerar_segredos.py https://crm.suaempresa.com.br > .env
#
# NUNCA versione o .env preenchido.

# --- Banco (PostgreSQL) ---
DB_NAME=miliano_crm
# Superusuário: administra o servidor, faz backup e restauração.
PG_ROOT_USER=miliano_root
PG_ROOT_PASSWORD=troque-por-uma-senha-forte
# Papel da aplicação: dono só deste banco. A senha entra numa URI
# (postgresql://...), então use letras, números, - e _ — um @ ou # nela
# quebra a conexão.
PG_APP_USER=miliano_app
PG_APP_PASSWORD=troque-por-outra-senha-forte

# --- Sessão ---
# python -c "import secrets; print(secrets.token_hex(48))"
# Trocar este valor desconecta todo mundo que estiver logado.
JWT_SECRET=troque-este-valor

# --- Endereços ---
# Domínio público do painel. Define a origem liberada no CORS e o modo do
# cookie de sessão.
FRONTEND_URL=https://crm.suaempresa.com.br
# Endereço que o navegador usa para falar com a API. Com o Nginx desta pilha,
# é o mesmo domínio do painel.
PUBLIC_API_URL=https://crm.suaempresa.com.br

# --- TLS (serviço `proxy`, Caddy) ---
# Domínio que o Caddy vai certificar. Precisa de um registro A/AAAA apontando
# para o IP deste servidor e das portas 80 e 443 abertas na internet — a 80 é
# usada no desafio da Let's Encrypt, não dá para fechá-la.
DOMINIO=crm.suaempresa.com.br
# Conta ACME: é por onde a Let's Encrypt avisa que a renovação falhou, semanas
# antes do certificado vencer. Use um e-mail que alguém lê.
ACME_EMAIL=ti@suaempresa.com.br

# Porta HTTP interna, publicada só no loopback — quem fala com a internet é o
# Caddy. Mude BIND_HTTP para 0.0.0.0 apenas se o seu proxy estiver em OUTRA
# máquina; nesse caso proteja a porta no firewall.
PORTA_HTTP=8080
BIND_HTTP=127.0.0.1
# Origens extras liberadas no CORS (painel em subdomínio separado, por
# exemplo). Em AMBIENTE=producao, só valem estas mais FRONTEND_URL.
CORS_ORIGINS=

# --- Contas iniciais ---
# Criadas no primeiro boot. A senha daqui só vale nesse momento: depois, cada
# pessoa troca a própria em "Minha conta".
ADMIN_EMAIL=admin@suaempresa.com.br
ADMIN_PASSWORD=troque-esta-senha
MANAGER_EMAIL=gestor@suaempresa.com.br
MANAGER_PASSWORD=troque-esta-senha

# --- Operação ---
AMBIENTE=producao
TIMEZONE=America/Sao_Paulo
# Dados de exemplo (restaurantes, pedidos e leads fictícios). Em produção eles
# só atrapalham, misturados ao dado real.
SEED_DEMO_DATA=false
# Cadastro público de usuário. Ligado, qualquer um com a URL cria conta.
ALLOW_PUBLIC_REGISTER=false

# --- Opcionais ---
# Monitoramento de erro. Vazio = desligado.
SENTRY_DSN=
# Link da política de privacidade, exibido no formulário público junto do
# aviso e do aceite.
PRIVACIDADE_URL=
# Dias de retenção dos backups no disco local.
RETENCAO_DIAS=14
# Cópia do backup para fora da máquina. Backup que mora na mesma VPS não
# sobrevive à perda dela. Aceita qualquer destino de `rclone` (bucket, Drive,
# S3) ou de `rsync` (usuario@host:/caminho). Vazio = só cópia local.
DESTINO_REMOTO=

# --- Alerta de queda (scripts/vigia.sh) ---
# URL que recebe POST com JSON quando a API para de responder. Serve
# qualquer webhook de Slack, Discord ou Teams. Vazio = só registra no log,
# e ninguém fica sabendo.
WEBHOOK_ALERTA=

# --- Limites de memória dos contêineres ---
# Sem teto, um pico do banco leva a máquina inteira junto.
MEM_DB=1g
MEM_API=1g
MEM_WEB=256m
MEM_PROXY=256m
