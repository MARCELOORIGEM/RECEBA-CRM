# Copie para .env e preencha. O .env real não deve ser versionado.

# --- Banco ---
MONGO_URL="mongodb://localhost:27017"
DB_NAME="miliano_crm"

# --- Segurança ---
# Gere um valor novo por ambiente:  python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET="troque-este-valor"
ACCESS_TTL_MINUTES=60
REFRESH_TTL_DAYS=7

# Tentativas de login erradas aceitas por e-mail+IP dentro da janela.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15

# Cadastro público. Deixe desligado: com ele ligado, qualquer pessoa com a URL
# da API cria uma conta (sempre como gestor, nunca administrador).
ALLOW_PUBLIC_REGISTER=false

# --- Fuso horário ---
# Define onde começa e termina "hoje" no painel e na agenda. Em UTC, o dia
# viraria às 21h no horário de São Paulo — bem no pico das entregas.
TIMEZONE="America/Sao_Paulo"

# --- Front-end e cookies ---
# Define a origem liberada no CORS e o modo do cookie de sessão.
# Com FRONTEND_URL em https, os cookies saem Secure + SameSite=None;
# em http local, saem SameSite=Lax — do contrário o navegador descarta o
# cookie e a sessão nunca gruda.
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS=""
# Só mexa nestes dois se precisar forçar um comportamento diferente do padrão.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# --- Contas iniciais ---
# Criadas na primeira subida. Troque as senhas antes de ir para produção.
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha"
MANAGER_EMAIL="gestor@exemplo.com"
MANAGER_PASSWORD="troque-esta-senha"

# --- Dados de demonstração ---
# Popula restaurantes, entregadores, pedidos, leads e atividades de exemplo
# quando as coleções estão vazias. Desligue em produção.
SEED_DEMO_DATA=true
